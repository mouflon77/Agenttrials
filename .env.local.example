# Copy to .env.local and fill in real values. Never commit .env.local — it is gitignored.

# Firebase project: agenttrials-xo (project number: 770439905353)
# Web app already registered — App ID format: 1:102513044244:web:...
# From Firebase Console > Project settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=agenttrials-xo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=agenttrials-xo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=agenttrials-xo.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=770439905353
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Your Firebase Auth UID — only this user can open /admin/editor
# Also create Firestore doc config/app with field adminUid = this same value (string)
NEXT_PUBLIC_ADMIN_UID=your_firebase_uid

# Optional: Gemini for NPC negotiation (falls back to keyword rules if unset or unavailable)
# Local dev: set here. Production: use Secret Manager via App Hosting (see apphosting.yaml).
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
# Never use NEXT_PUBLIC_ prefix for these
# TWITTER_CLIENT_ID=your_twitter_client_id
# TWITTER_CLIENT_SECRET=your_twitter_client_secret

# Solana — NPC bribes (defaults to devnet). Use mainnet RPC in production if needed.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# ─── Agent wallets (Turnkey + GCP + Guardian) ───────────────────────────────
# GCP project id = same as Firebase project id
GCP_PROJECT_ID=agenttrials-xo

# One-time bootstrap: upload Turnkey parent-org keys to GCP Secret Manager.
# Run from AgentWallets repo OR set these temporarily, then call bootstrap:
#   TURNKEY_API_PUBLIC_KEY=...
#   TURNKEY_API_PRIVATE_KEY=...
#   TURNKEY_ORGANIZATION_ID=...
#   npm run gcp:bootstrap
# After bootstrap, remove TURNKEY_API_* from .env — runtime reads from Secret Manager.

# Turnkey dashboard (parent org) — browser Passkey client
NEXT_PUBLIC_TURNKEY_ORGANIZATION_ID=your_turnkey_org_id
# WebAuthn RP ID = hostname only (localhost for dev; your App Hosting domain in prod)
NEXT_PUBLIC_RP_ID=localhost
# NEXT_PUBLIC_TURNKEY_API_BASE_URL=https://api.turnkey.com

# App origin for guardian setup links (dev / production)
# APP_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_APP_ORIGIN=https://your-app-hosting-url.web.app

# Agent auto-sign threshold (SOL) — transfers below this skip phone approval
AUTO_SIGN_THRESHOLD_SOL=0.1

# Server-only — ONLY for API routes (agent wallet create, guardian backend).
# NOT used for tile uploads, room editor paint, or storage uploads.
# Production App Hosting: omit this (Cloud Run uses built-in credentials).
# Local dev: only add if "Create wallet" fails with a Firestore permission error.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional demo recipient for guardian "Simulate request" button
# DEMO_RECIPIENT_ADDRESS=11111111111111111111111111111112
