# Copy to .env.local and fill in real values. Never commit .env.local — it is gitignored.

# Firebase project: agenttrials-xo (project number: 770439905353)
# Web app already registered — App ID format: 1:102513044244:web:...
# From Firebase Console > Project settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=agenttrials-xo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=agenttrials-xo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=agenttrials-xo.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=770439905353
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Your Firebase Auth UID — only this user can open /admin/editor
# Also create Firestore doc config/app with field adminUid = this same value (string)
NEXT_PUBLIC_ADMIN_UID=your_firebase_uid

# Optional: Gemini for NPC negotiation (falls back to keyword rules if unset)
# GEMINI_API_KEY=your_gemini_api_key
# Never use NEXT_PUBLIC_ prefix for these
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
